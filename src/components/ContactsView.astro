---
import { ui, type Locale } from '../i18n/ui';
import { siteConfig } from '../siteConfig';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const address = lang === 'ru' ? siteConfig.address : siteConfig.addressKk;
const phone = siteConfig.phone;
const email = siteConfig.email;
const cards = [
  {
    label: t.contacts.address,
    value: address,
    href: null,
    icon: '<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  },
  {
    label: t.contacts.phone,
    value: phone,
    href: `tel:${phone.replace(/[^+\d]/g, '')}`,
    icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/>',
  },
  {
    label: t.contacts.email,
    value: email,
    href: `mailto:${email}`,
    icon: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  },
  {
    label: t.contacts.workingHours,
    value: t.contacts.workingHoursValue,
    href: null,
    icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  },
];
---

<section class="py-20">
  <div class="container">
    <div class="text-center mb-12 reveal">
      <span class="eyebrow mb-4">{t.contacts.title}</span>
      <h2 class="text-[clamp(28px,4vw,38px)] font-extrabold m-0">{t.contacts.title}</h2>
    </div>

    <div class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-5 mb-16">
      {cards.map((c, i) => (
        <div class="bg-white border border-[var(--color-border)] rounded-2xl p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-md)] hover:border-[var(--color-primary-soft)] reveal" style={`transition-delay:${i * 80}ms`}>
          <div class="w-11 h-11 rounded-xl bg-[var(--color-primary-soft)] flex items-center justify-center text-[var(--color-primary)] mb-4">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
          </div>
          <h3 class="m-0 mb-2 text-lg">{c.label}</h3>
          {c.href ? (
            <p class="m-0"><a class="text-[var(--color-primary)] font-semibold no-underline hover:text-[var(--color-primary-hover)] transition-colors" href={c.href}>{c.value}</a></p>
          ) : (
            <p class="m-0 text-[var(--color-text-secondary)]">{c.value}</p>
          )}
        </div>
      ))}
    </div>

    <div class="bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-primary)] text-white rounded-3xl py-16 px-8 text-center shadow-[var(--shadow-lg)] reveal">
      <h2 class="text-white text-[32px] m-0 mb-3">{lang === 'ru' ? 'Остались вопросы?' : 'Сұрақтарыңыз бар ма?'}</h2>
      <p class="text-white/80 text-lg max-w-[520px] mx-auto m-0 mb-7">{lang === 'ru' ? 'Свяжитесь с нами — мы ответим на все вопросы о школе и поступлении.' : 'Бізге хабарласыңыз — біз мектеп пен қабылдау туралы барлық сұрақтарыңызға жауап береміз.'}</p>
      <a class="inline-flex items-center gap-2 bg-white text-[var(--color-primary)] px-8 py-3.5 rounded-2xl text-base font-bold no-underline hover:bg-[var(--color-primary-soft)] transition-colors" href={lang === 'ru' ? '/feedback/' : '/kk/feedback/'}>
        <span>{lang === 'ru' ? 'Задать вопрос' : 'Сұрақ қою'}</span><span>&rarr;</span>
      </a>
    </div>
  </div>
</section>