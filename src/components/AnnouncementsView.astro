---
import { ui, type Locale } from '../i18n/ui';
import { supabase } from '../lib/supabase';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang].announcements;

const { data: announcements } = await supabase
  .from('announcements')
  .select('id, title, content, audience, pinned, lang, date')
  .eq('lang', lang)
  .order('pinned', { ascending: false })
  .order('date', { ascending: false });

const AUDIENCE_LABELS = {
  all: lang === 'ru' ? 'Для всех' : 'Барлығына',
  students: lang === 'ru' ? 'Для учеников' : 'Оқушыларға',
  teachers: lang === 'ru' ? 'Для учителей' : 'Мұғалімдерге',
  parents: lang === 'ru' ? 'Для родителей' : 'Ата-аналарға',
} as const;
---

<section class="py-16">
  <div class="container">
    <h2 class="text-[clamp(28px,4vw,38px)] font-extrabold mb-8">{t.title}</h2>
    {announcements && announcements.length > 0 ? (
      <div class="flex flex-col gap-4">
        {announcements.map(a => (
          <article class:list={['bg-white border border-[var(--color-border)] rounded-2xl p-6 flex gap-5 items-start shadow-sm', a.pinned ? 'border-t-4 border-t-[var(--color-primary)]' : '']}>
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2 flex-wrap">
                <h3 class="text-lg font-bold m-0">{a.title}</h3>
                {a.pinned && <span class="px-2.5 py-0.5 bg-[var(--color-primary-soft)] text-[var(--color-primary)] rounded-full text-xs font-bold">{lang === 'ru' ? 'Закреплено' : 'Бекітілген'}</span>}
                <span class="px-2.5 py-0.5 bg-[var(--color-bg-soft)] text-[var(--color-text-secondary)] rounded-full text-xs font-semibold">{AUDIENCE_LABELS[a.audience as keyof typeof AUDIENCE_LABELS] ?? a.audience}</span>
              </div>
              <p class="text-[var(--color-text-secondary)] leading-relaxed m-0 mb-2 whitespace-pre-line">{a.content}</p>
              <time class="text-xs text-[var(--color-text-muted)]">{new Date(a.date).toLocaleDateString(lang === 'ru' ? 'ru-RU' : 'kk-KZ')}</time>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="text-center text-[var(--color-text-secondary)] py-12">{t.empty}</p>
    )}
  </div>
</section>