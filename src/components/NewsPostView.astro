---
import { ui, type Locale } from '../i18n/ui';
import { marked } from 'marked';

interface Props {
  lang: Locale;
  news: {
    title: string;
    description: string;
    content: string;
    date: string;
    image_url?: string | null;
  };
  similar?: Array<{
    id: string;
    title: string;
    description: string;
    date: string;
    image_url?: string | null;
  }>;
}

function sanitize(html: string): string {
  return html
    .replace(/<script\b[^>]*>[\s\S]*?<\/script\s*>/gi, '')
    .replace(/<style\b[^>]*>[\s\S]*?<\/style\s*>/gi, '')
    .replace(/\son\w+\s*=\s*("[^"]*"|'[^']*'|[^\s>]+)/gi, '')
    .replace(/javascript:/gi, '');
}

const { lang, news, similar = [] } = Astro.props;
const t = ui[lang];
const prefix = lang === 'ru' ? '' : '/kk';
const shareUrl = Astro.url.origin + Astro.url.pathname;
const shareTitle = encodeURIComponent(news.title);
const contentHtml = sanitize(String(marked.parse(news.content)));
const fmtDate = new Intl.DateTimeFormat(lang === 'ru' ? 'ru-RU' : 'kk-KZ', { day: 'numeric', month: 'long', year: 'numeric' });
---

<section class="py-20 pb-24">
  <div class="max-w-[780px] mx-auto px-4">
    <a class="inline-flex items-center gap-2.5 mb-9 text-sm font-semibold text-[var(--color-text-secondary)] no-underline hover:text-[var(--color-primary)] transition-colors reveal" href={`${prefix}/news/`}>
      <span class="w-8 h-8 rounded-[10px] bg-[var(--color-primary-soft)] text-[var(--color-primary)] inline-flex items-center justify-center transition-transform hover:-translate-x-0.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
      </span>
      {t.news.back}
    </a>
    <article class="reveal">
      <header class="mb-10">
        <time class="text-[var(--color-text-secondary)] text-[13px] uppercase tracking-widest font-semibold" datetime={news.date}>{fmtDate.format(new Date(news.date))}</time>
        <h1 class="text-[clamp(32px,5vw,52px)] leading-tight font-extrabold m-0 mt-3.5 mb-4">{news.title}</h1>
        <p class="text-[var(--color-text-secondary)] text-lg m-0 mb-10 leading-relaxed">{news.description}</p>
      </header>
      {news.image_url && (
        <div class="rounded-2xl border border-[var(--color-border)] overflow-hidden shadow-[var(--shadow-md)] mb-11">
          <img src={news.image_url} alt="" class="w-full" loading="lazy" />
        </div>
      )}
      <div class="prose" set:html={contentHtml}></div>
    </article>

    <div class="mt-14 pt-9 border-t border-[var(--color-border)] reveal">
      <h2 class="text-sm font-extrabold uppercase tracking-wider text-[var(--color-text-secondary)] m-0 mb-4">{t.share}</h2>
      <div class="flex flex-wrap items-center gap-2.5" data-share>
        <a class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#229ED9] text-white rounded-xl text-sm font-bold no-underline hover:opacity-90 transition-opacity" href={`https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${shareTitle}`} target="_blank" rel="noopener" aria-label="Telegram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          Telegram
        </a>
        <a class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#25D366] text-white rounded-xl text-sm font-bold no-underline hover:opacity-90 transition-opacity" href={`https://wa.me/?text=${shareTitle}%20${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          WhatsApp
        </a>
        <a class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#0077FF] text-white rounded-xl text-sm font-bold no-underline hover:opacity-90 transition-opacity" href={`https://vk.com/share.php?url=${encodeURIComponent(shareUrl)}&title=${shareTitle}`} target="_blank" rel="noopener" aria-label="VK">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M15.684 0H8.316C1.592 0 0 1.592 0 8.316v7.368C0 22.408 1.592 24 8.316 24h7.368C22.408 24 24 22.408 24 15.684V8.316C24 1.592 22.408 0 15.684 0zm3.692 17.123h-1.744c-.66 0-.864-.525-2.05-1.71-1.033-1.002-1.49-1.13-1.74-1.13-.356 0-.458.102-.458.593v1.558c0 .424-.135.678-1.253.678-1.846 0-3.892-1.12-5.335-3.207C4.643 11.104 4.02 8.97 4.02 8.566c0-.254.102-.508.593-.508h1.744c.44 0 .61.203.78.677.848 2.46 2.28 4.607 2.865 4.607.22 0 .322-.102.322-.66V9.746c-.07-1.186-.695-1.286-.695-1.71 0-.203.17-.406.44-.406h2.744c.373 0 .508.203.508.626v3.388c0 .373.17.508.271.508.22 0 .407-.135.847-.576 1.354-1.523 2.322-3.863 2.322-3.863.135-.255.322-.508.763-.508h1.744c.525 0 .643.271.525.643-.22 1.017-2.373 4.302-2.373 4.302-.186.305-.25.44 0 .78.186.254.797.779 1.203 1.253.746.847 1.32 1.559 1.473 2.05.152.49-.254.728-.898.728z"/></svg>
          VK
        </a>
        <button type="button" data-copy class="inline-flex items-center gap-2 px-4 py-2.5 bg-[var(--color-bg-soft)] border border-[var(--color-border)] text-[var(--color-text-primary)] rounded-xl text-sm font-bold cursor-pointer hover:bg-[var(--color-primary-soft)] transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span data-copy-label>{lang === 'ru' ? 'Скопировать' : 'Көшіру'}</span>
        </button>
      </div>
    </div>

    {similar.length > 0 && (
      <div class="mt-12 reveal">
        <h2 class="text-xl font-extrabold m-0 mb-6">{t.similar}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {similar.map(s => (
            <a href={`${prefix}/news/${s.id}/`} class="group bg-white border border-[var(--color-border)] rounded-2xl overflow-hidden no-underline text-[var(--color-text-primary)] shadow-sm transition-all hover:shadow-[var(--shadow-md)] hover:-translate-y-0.5">
              {s.image_url && <img src={s.image_url} alt="" class="w-full h-40 object-cover" loading="lazy" />}
              <div class="p-5">
                <time class="text-xs text-[var(--color-text-muted)]">{fmtDate.format(new Date(s.date))}</time>
                <h3 class="text-base font-bold leading-snug m-0 mt-1.5 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2">{s.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script>
  const copyBtn = document.querySelector('[data-copy]');
  const copyLabel = document.querySelector('[data-copy-label]');
  if (copyBtn && copyLabel) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyLabel.textContent = '✓ ' + (copyLabel.textContent?.includes('Көшіру') ? 'Көшірілді' : 'Скопировано');
        setTimeout(() => { copyLabel.textContent = copyLabel.textContent?.includes('Көшіру') ? 'Көшіру' : 'Скопировать'; }, 2000);
      } catch { /* clipboard unavailable */ }
    });
  }
</script>