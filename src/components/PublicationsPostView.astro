---
import { ui, type Locale } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Locale;
  entry: CollectionEntry<'publications'>;
}
const { lang, entry } = Astro.props;
const t = ui[lang];
const prefix = lang === 'ru' ? '' : '/kk';
const { render } = await import('astro:content');
const { Content } = await render(entry);
const fmtDate = new Intl.DateTimeFormat(lang === 'ru' ? 'ru-RU' : 'kk-KZ', { day: 'numeric', month: 'long', year: 'numeric' });
const { Image } = await import('astro:assets');
---

<section class="py-20 pb-24">
  <div class="max-w-[780px] mx-auto px-4">
    <a class="inline-flex items-center gap-2.5 mb-9 text-sm font-semibold text-[var(--color-text-secondary)] no-underline hover:text-[var(--color-primary)] transition-colors reveal" href={`${prefix}/publications/`}>
      <span class="w-8 h-8 rounded-[10px] bg-[var(--color-primary-soft)] text-[var(--color-primary)] inline-flex items-center justify-center transition-transform hover:-translate-x-0.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
      </span>
      {t.publications.back}
    </a>
    <article class="reveal">
      <header class="mb-10">
        <div class="flex items-center gap-3.5 flex-wrap text-[var(--color-text-secondary)] text-[13px] uppercase tracking-widest font-semibold">
          <time datetime={entry.data.date.toISOString()}>{fmtDate.format(entry.data.date)}</time>
          <span class="text-[var(--color-primary)] font-bold normal-case">{entry.data.author}</span>
        </div>
        <h1 class="text-[clamp(32px,5vw,52px)] leading-tight font-extrabold m-0 mt-3.5 mb-4">{entry.data.title}</h1>
        <p class="text-[var(--color-text-secondary)] text-lg m-0 mb-10 leading-relaxed">{entry.data.description}</p>
      </header>
      {entry.data.image && (
        <div class="rounded-2xl border border-[var(--color-border)] overflow-hidden shadow-[var(--shadow-md)] mb-11">
          <Image src={entry.data.image} alt="" class="w-full" />
        </div>
      )}
      <div class="prose"><Content /></div>
    </article>
  </div>
</section>