---
import { ui, type Locale } from '../i18n/ui';
import { siteConfig } from '../siteConfig';
import PostCard from './PostCard.astro';
import TeachersView from './TeachersView.astro';
import { supabase } from '../lib/supabase';
import { getCollection } from 'astro:content';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const prefix = lang === 'ru' ? '' : '/kk';
const { data: news } = await supabase
  .from('news')
  .select('id, slug, title, description, date, image_url')
  .eq('lang', lang)
  .order('date', { ascending: false })
  .limit(3);
const pubs = (await getCollection('publications'))
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const { data: announcements } = await supabase
  .from('announcements')
  .select('id, title, content, audience, pinned, lang, date')
  .eq('lang', lang)
  .order('pinned', { ascending: false })
  .order('date', { ascending: false })
  .limit(3);
---

<section class="relative overflow-hidden bg-gradient-to-br from-[var(--color-navy)] via-[#243a5e] to-[#1b2c4a] text-white py-20">
  <div class="absolute inset-0 opacity-[0.05]" aria-hidden="true" style="background-image: radial-gradient(circle at 25% 25%, white 1px, transparent 1px); background-size: 28px 28px;"></div>
  <div class="container relative">
    <div class="grid grid-cols-[1.1fr_0.9fr] gap-16 items-center max-lg:grid-cols-1 max-lg:gap-10">
      <div class="reveal">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-blue-200 bg-white/10 border border-white/15 mb-5">{lang === 'ru' ? 'Образование будущего' : 'Болашақ білімі'}</span>
        <h1 class="text-[clamp(36px,5vw,56px)] leading-[1.1] mb-5 text-white">{t.home.heroTitle}</h1>
        <p class="text-lg text-slate-300 leading-relaxed mb-9 max-w-[520px]">{t.home.heroSubtitle}</p>
        <div class="flex gap-4 flex-wrap">
          <a class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white px-7 py-3 rounded-2xl text-base font-bold no-underline shadow-[0_4px_14px_rgba(37,99,235,0.3)] hover:bg-[#3b82f6] hover:-translate-y-0.5 transition-all" href={`${prefix}/about/`}>
            <span>{t.home.heroCta}</span><span>&rarr;</span>
          </a>
          <a class="inline-flex items-center gap-2 bg-white/10 text-white px-7 py-3 rounded-2xl text-base font-bold no-underline border border-white/20 backdrop-blur hover:bg-white/20 hover:-translate-y-0.5 transition-all" href={`${prefix}/news/`}>
            <span>{t.home.newsTitle}</span>
          </a>
        </div>
      </div>
      <div class="reveal">
        <div class="aspect-[4/5] max-h-[440px] w-full max-w-[380px] mx-auto rounded-3xl overflow-hidden bg-white/5 border border-white/15 shadow-[var(--shadow-lg)]">
          <img src="/school-photo.jpg" alt={siteConfig.name[lang]} width="480" height="600" class="w-full h-full object-cover" loading="eager" />
          <div class="bg-[var(--color-navy)]/95 backdrop-blur px-4 py-3 flex items-center justify-center gap-3">
            <img src="/emblem-taraz.png" alt="" width="32" height="32" class="w-8 h-8 rounded-full object-contain shrink-0" loading="eager" />
            <p class="text-[12px] font-extrabold tracking-[0.12em] text-blue-100 text-center uppercase m-0">{lang === 'ru' ? 'Школа №2 · Тараз' : '№2 мектеп · Тараз'}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-white border-b border-[var(--color-border)] py-10">
  <div class="container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-[var(--color-primary-soft)] flex items-center justify-center text-[var(--color-primary)] shrink-0">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        </div>
        <div><h4 class="m-0 text-[26px] font-extrabold text-[var(--color-text-primary)]">1,200+</h4><p class="m-0 text-sm text-[var(--color-text-secondary)]">{lang === 'ru' ? 'Учеников' : 'Оқушы'}</p></div>
      </div>
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-[var(--color-primary-soft)] flex items-center justify-center text-[var(--color-primary)] shrink-0">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div><h4 class="m-0 text-[26px] font-extrabold text-[var(--color-text-primary)]">80+</h4><p class="m-0 text-sm text-[var(--color-text-secondary)]">{lang === 'ru' ? 'Учителей' : 'Мұғалім'}</p></div>
      </div>
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-[var(--color-primary-soft)] flex items-center justify-center text-[var(--color-primary)] shrink-0">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-4h6v4"/></svg>
        </div>
        <div><h4 class="m-0 text-[26px] font-extrabold text-[var(--color-text-primary)]">25</h4><p class="m-0 text-sm text-[var(--color-text-secondary)]">{lang === 'ru' ? 'Лет истории' : 'Жылдық тарих'}</p></div>
      </div>
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-[var(--color-primary-soft)] flex items-center justify-center text-[var(--color-primary)] shrink-0">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
        </div>
        <div><h4 class="m-0 text-[26px] font-extrabold text-[var(--color-text-primary)]">30+</h4><p class="m-0 text-sm text-[var(--color-text-secondary)]">{lang === 'ru' ? 'Секций' : 'Үйірме'}</p></div>
      </div>
    </div>
  </div>
</section>

<section class="py-24">
  <div class="container">
    <div class="flex items-end justify-between mb-10 reveal">
      <div>
        <span class="eyebrow mb-4">{t.home.newsTitle}</span>
        <h2 class="text-[clamp(28px,4vw,38px)] font-extrabold m-0">{t.home.newsTitle}</h2>
      </div>
      <a class="inline-flex items-center gap-1.5 text-[var(--color-primary)] font-bold text-[15px] no-underline hover:text-[var(--color-primary-hover)] transition-colors" href={`${prefix}/news/`}>
        <span>{t.home.newsAll}</span><span>&rarr;</span>
      </a>
    </div>
    {news && news.length > 0 ? (
      <div class="grid grid-cols-3 gap-7 max-lg:grid-cols-1">
        {news.map((n, i) => (
          <div class="reveal" style={`transition-delay:${i * 80}ms`}>
            <PostCard item={n} collection="news" lang={lang} readMore={t.news.readMore} />
          </div>
        ))}
      </div>
    ) : <p>{t.news.empty}</p>}
  </div>
</section>

<section class="py-24 bg-[var(--color-navy-soft)]">
  <div class="container">
    <div class="flex items-end justify-between mb-10 reveal">
      <div>
        <span class="eyebrow mb-4">{t.announcements.title}</span>
        <h2 class="text-[clamp(28px,4vw,38px)] font-extrabold m-0">{t.announcements.title}</h2>
      </div>
      <a class="inline-flex items-center gap-1.5 text-[var(--color-primary)] font-bold text-[15px] no-underline hover:text-[var(--color-primary-hover)] transition-colors" href={`${prefix}/announcements/`}>
        <span>{t.home.newsAll}</span><span>&rarr;</span>
      </a>
    </div>
    {announcements && announcements.length > 0 ? (
      <div class="grid grid-cols-3 gap-7 max-lg:grid-cols-1">
        {announcements.map((a, i) => (
          <div class:list={['reveal bg-white border border-[var(--color-border)] rounded-2xl p-6 flex flex-col gap-3 shadow-sm transition-all hover:shadow-[var(--shadow-md)]', a.pinned ? 'border-t-4 border-t-[var(--color-primary)]' : '']} style={`transition-delay:${i * 80}ms`}>
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class="text-base font-bold m-0">{a.title}</h3>
              {a.pinned && <span class="inline-flex items-center gap-1 px-2.5 py-0.5 bg-[var(--color-primary-soft)] text-[var(--color-primary)] rounded-full text-xs font-bold"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4l6 6-2.5 2.5-1-1-4 4 1 1L11 18l-6-6 2.5-2.5 1 1 4-4-1-1z"/><path d="M5 19l-3 3"/></svg>Закреплено</span>}
            </div>
            <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed m-0 line-clamp-3">{a.content}</p>
            <time class="text-xs text-[var(--color-text-muted)] mt-auto">{new Date(a.date).toLocaleDateString(lang === 'ru' ? 'ru-RU' : 'kk-KZ')}</time>
          </div>
        ))}
      </div>
    ) : (
      <p>{t.announcements.empty}</p>
    )}
  </div>
</section>

<section class="py-24 bg-white">
  <div class="container">
    <div class="flex items-end justify-between mb-10 reveal">
      <div>
        <span class="eyebrow mb-4">{t.home.publicationsTitle}</span>
        <h2 class="text-[clamp(28px,4vw,38px)] font-extrabold m-0">{t.home.publicationsTitle}</h2>
      </div>
      <a class="inline-flex items-center gap-1.5 text-[var(--color-primary)] font-bold text-[15px] no-underline hover:text-[var(--color-primary-hover)] transition-colors" href={`${prefix}/publications/`}>
        <span>{t.home.publicationsAll}</span><span>&rarr;</span>
      </a>
    </div>
    {pubs.length > 0 ? (
      <div class="grid grid-cols-3 gap-7 max-lg:grid-cols-1">
        {pubs.map((p, i) => (
          <div class="reveal" style={`transition-delay:${i * 80}ms`}>
            <PostCard item={p} collection="publications" lang={lang} readMore={t.publications.readMore} />
          </div>
        ))}
      </div>
    ) : <p>{t.publications.empty}</p>}
  </div>
</section>

<section class="py-24 bg-[var(--color-bg-soft)]">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow mb-4">{t.teachers.title}</span>
      <h2 class="text-[clamp(28px,4vw,38px)] font-extrabold mb-8 m-0">{t.teachers.title}</h2>
    </div>
    <TeachersView lang={lang} />
  </div>
</section>