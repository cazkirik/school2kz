---
import { ui, type Locale } from '../i18n/ui';
import { supabase } from '../lib/supabase';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const { data: clubs } = await supabase
  .from('clubs')
  .select('*')
  .eq('lang', lang)
  .order('sort_order', { ascending: true });
---

<section class="py-20">
  <div class="container">
    <div class="mb-12 text-center">
      <span class="eyebrow mb-4">{t.clubs.title}</span>
      <h1 class="text-[clamp(28px,4vw,38px)] font-extrabold m-0 mb-3">{t.clubs.title}</h1>
      <p class="text-[var(--color-text-secondary)] m-0">{t.clubs.subtitle}</p>
    </div>

    {!clubs || clubs.length === 0 ? (
      <p class="text-center text-[var(--color-text-secondary)]">{t.clubs.empty}</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {clubs.map((club, i) => (
          <article class="bg-white border border-[var(--color-border)] rounded-2xl overflow-hidden shadow-sm transition-all hover:shadow-[var(--shadow-lg)] hover:-translate-y-1 hover:border-[var(--color-primary-soft)] reveal" style={`transition-delay:${i * 60}ms`}>
            {club.image_url ? (
              <div class="aspect-[16/9] overflow-hidden bg-[var(--color-bg-soft)]">
                <img src={club.image_url} alt={club.title} class="w-full h-full object-cover" loading="lazy" />
              </div>
            ) : (
              <div class="aspect-[16/9] bg-gradient-to-br from-[var(--color-navy-soft)] to-[var(--color-primary-soft)] flex items-center justify-center">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 16.1A5 5 0 0 1 5.9 20H2z"/><path d="M5.9 20a2 2 0 0 1-3.9-3.9M6 8h12a6 6 0 0 1 0 12h-8a8 8 0 0 1-4-20z"/><path d="M11 4V2"/></svg>
              </div>
            )}
            <div class="p-6">
              <h2 class="text-xl font-extrabold m-0 mb-2">{club.title}</h2>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed m-0 mb-4 whitespace-pre-line">{club.description}</p>
              <div class="flex flex-col gap-2 text-[13px]">
                {club.leader && (
                  <div class="flex items-center gap-2 text-[var(--color-text-secondary)]">
                    <svg class="shrink-0 text-[var(--color-primary)]" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <span><b>{t.clubs.leader}:</b> {club.leader}</span>
                  </div>
                )}
                {club.schedule && (
                  <div class="flex items-center gap-2 text-[var(--color-text-secondary)]">
                    <svg class="shrink-0 text-[var(--color-primary)]" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    <span><b>{t.clubs.scheduleLabel}:</b> {club.schedule}</span>
                  </div>
                )}
                {club.room && (
                  <div class="flex items-center gap-2 text-[var(--color-text-secondary)]">
                    <svg class="shrink-0 text-[var(--color-primary)]" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 9v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9"/><path d="M9 22V12h6v10"/><path d="M2 10a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v1H2z"/></svg>
                    <span><b>{t.clubs.room}:</b> {club.room}</span>
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>