---
import { ui, type Locale } from '../i18n/ui';
import { siteConfig } from '../siteConfig';
import { supabase } from '../lib/supabase';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const { data: galleryRows } = await supabase
  .from('gallery')
  .select('image_url, caption_ru, caption_kk')
  .order('sort_order', { ascending: true });
const fallbackGallery = [
  { image_url: '/images/school-1.jpg', caption_ru: 'Здание школы №2', caption_kk: '№2 мектеп ғимараты' },
  { image_url: '/images/school-2.jpg', caption_ru: 'Наша школа', caption_kk: 'Біздің мектеп' },
  { image_url: '/images/school-3.jpg', caption_ru: 'Школьные будни', caption_kk: 'Мектеп күндері' },
  { image_url: '/images/school-4.jpg', caption_ru: 'Уроки и перемены', caption_kk: 'Сабақтар мен үзілістер' },
  { image_url: '/images/school-5.jpg', caption_ru: 'Наш коллектив', caption_kk: 'Біздің ұжым' },
  { image_url: '/images/school-6.jpg', caption_ru: 'Моменты жизни школы', caption_kk: 'Мектеп өмірінің сәттері' },
  { image_url: '/images/school-7.jpg', caption_ru: 'Школьный двор', caption_kk: 'Мектеп ауласы' },
];
const gallery = galleryRows && galleryRows.length > 0 ? galleryRows : fallbackGallery;
const heroImage = gallery[0]?.image_url ?? '/images/school-1.jpg';
const content = {
  ru: {
    intro: 'Коммунальное государственное учреждение «Средняя школа №2 города Тараз управления образования акимата Жамбылской области» осуществляет образовательную деятельность в соответствии с Законом Республики Казахстан «Об образовании» и Государственным общеобязательным стандартом образования. Школа реализует общеобразовательные программы начального, основного среднего и общего среднего образования.',
    heading1: 'Основные направления деятельности',
    directorLabel: 'Директор школы',
    values: [
      'Обеспечение качественного и доступного общего среднего образования',
      'Воспитание казахстанского патриотизма и гражданственности у обучающихся',
      'Развитие творческого, научного и спортивного потенциала учеников',
      'Внедрение современных образовательных технологий и цифровизация обучения',
    ],
    heading2: 'Школа в цифрах',
    stats: [
      { num: '1,200+', label: 'обучающихся' },
      { num: '80+', label: 'педагогических работников' },
      { num: '25', label: 'лет деятельности' },
      { num: '30+', label: 'кружков и секций' },
    ],
  },
  kk: {
    intro: 'Жамбыл облысы әкімдігінің білім басқармасы Тараз қаласының білім бөлімінің «Тараз қаласының №2 орта мектебі» коммуналдық мемлекеттік мекемесі «Білім туралы» Қазақстан Республикасы Заңына және Мемлекеттік жалпыға міндетті білім беру стандартына сәйкес білім беру қызметін жүзеге асырады. Мектеп бастауыш, негізгі орта және жалпы орта білім берудің жалпы білім беретін бағдарламаларын іске асырады.',
    heading1: 'Қызметтің негізгі бағыттары',
    directorLabel: 'Мектеп директоры',
    values: [
      'Сапалы және қолжетімді жалпы орта білім беруді қамтамасыз ету',
      'Оқушыларда қазақстандық патриотизм мен азаматтықты тәрбиелеу',
      'Оқушылардың шығармашылық, ғылыми және спорттық әлеуетін дамыту',
      'Оқытуда заманауи білім беру технологияларын енгізу және цифрландыру',
    ],
    heading2: 'Мектеп сандармен',
    stats: [
      { num: '1,200+', label: 'оқушы' },
      { num: '80+', label: 'педагог қызметкер' },
      { num: '25', label: 'жыл қызмет' },
      { num: '30+', label: 'үйірме мен секция' },
    ],
  },
}[lang];
---

<section class="py-20">
  <div class="container">
    <div class="grid grid-cols-[1.1fr_0.9fr] gap-16 items-center mb-20 max-lg:grid-cols-1 max-lg:gap-8">
      <div class="reveal">
        <span class="eyebrow mb-4">{t.about.title}</span>
        <h1 class="text-[clamp(32px,5vw,48px)] font-extrabold m-0 mb-4">{siteConfig.name[lang]}</h1>
        <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed m-0">{content.intro}</p>
      </div>
      <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-[var(--shadow-lg)] reveal">
        <img src={heroImage} alt={siteConfig.name[lang]} width="800" height="600" class="w-full h-full object-cover" loading="lazy" />
      </div>
    </div>

    <div class="mb-20 flex items-center gap-6 p-8 bg-white border border-[var(--color-border)] rounded-2xl shadow-sm max-md:flex-col max-md:text-center">
      <div class="w-20 h-20 rounded-full bg-[var(--color-primary-soft)] flex items-center justify-center shrink-0">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
      </div>
      <div class="reveal">
        <span class="eyebrow mb-2">{content.directorLabel}</span>
        <p class="text-xl font-extrabold m-0">{siteConfig.director[lang]}</p>
      </div>
    </div>

    <div class="mb-20">
      <h3 class="text-[28px] font-extrabold m-0 mb-7 reveal">{lang === 'ru' ? 'Наша школа в фотографиях' : 'Мектеп фотосуреттерде'}</h3>
      <div class="grid grid-cols-3 gap-5 max-md:grid-cols-1">
        {gallery.map((img, i) => (
          <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-sm hover:shadow-[var(--shadow-lg)] transition-all hover:-translate-y-1 reveal" style={`transition-delay:${i * 60}ms`}>
            <img src={img.image_url} alt={lang === 'ru' ? img.caption_ru : img.caption_kk} class="w-full h-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    </div>

    <div class="mb-20">
      <h3 class="text-[28px] font-extrabold m-0 mb-7 reveal">{content.heading1}</h3>
      <div class="grid grid-cols-2 gap-5 max-md:grid-cols-1">
        {content.values.map((v, i) => (
          <div class="flex gap-4 items-start p-6 bg-[var(--color-bg-soft)] border border-[var(--color-border)] rounded-2xl reveal" style={`transition-delay:${i * 80}ms`}>
            <span class="text-sm font-extrabold text-[var(--color-primary)] bg-[var(--color-primary-soft)] px-2.5 py-1 rounded-lg shrink-0">0{i + 1}</span>
            <p class="m-0 text-base text-[var(--color-text-primary)] font-semibold">{v}</p>
          </div>
        ))}
      </div>
    </div>

    <div>
      <h3 class="text-[28px] font-extrabold m-0 mb-7 reveal">{content.heading2}</h3>
      <div class="grid grid-cols-4 gap-5 max-md:grid-cols-2">
        {content.stats.map((s, i) => (
          <div class="bg-white border border-[var(--color-border)] rounded-2xl py-8 px-5 text-center shadow-sm reveal" style={`transition-delay:${i * 80}ms`}>
            <span class="block text-[36px] font-extrabold text-[var(--color-primary)] leading-none mb-2">{s.num}</span>
            <span class="text-sm text-[var(--color-text-secondary)]">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>