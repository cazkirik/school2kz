---
import { ui, type Locale } from '../i18n/ui';
import PostCard from './PostCard.astro';
import { supabase } from '../lib/supabase';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];

const { data: news } = await supabase
  .from('news')
  .select('id, slug, title, description, date, image_url')
  .eq('lang', lang)
  .order('date', { ascending: false });
const items = news ?? [];
---

<section class="py-20">
  <div class="container">
    <div class="text-center mb-12 reveal">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-[var(--color-primary)] bg-[var(--color-primary-soft)] mb-4">{t.news.title}</span>
      <h1 class="text-[clamp(28px,4vw,38px)] font-extrabold">{t.news.title}</h1>
    </div>

    <div class="max-w-md mx-auto mb-12 relative reveal">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-[var(--color-text-muted)]" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="news-search" type="search" placeholder={t.search.placeholder} class="w-full pl-11 pr-4 py-3 border border-[var(--color-border)] rounded-xl text-base font-[inherit] bg-white shadow-sm focus:outline-none focus:border-[var(--color-primary)] transition-colors" />
    </div>

    {items.length > 0 ? (
      <div id="news-grid" class="grid grid-cols-3 gap-7 max-lg:grid-cols-1">
        {items.map((n, i) => (
          <div class="reveal news-card" data-title={(n.title ?? '').toLowerCase()} style={`transition-delay:${i * 70}ms`}>
            <PostCard item={n} collection="news" lang={lang} readMore={t.news.readMore} />
          </div>
        ))}
      </div>
    ) : (
      <p class="text-center text-[var(--color-text-secondary)]">{t.news.empty}</p>
    )}
    <p id="news-empty" class="hidden text-center text-[var(--color-text-secondary)]">{t.search.noResults}</p>
  </div>
</section>

<script>
  const searchInput = document.getElementById('news-search') as HTMLInputElement | null;
  const emptyEl = document.getElementById('news-empty') as HTMLElement | null;
  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    let visible = 0;
    document.querySelectorAll<HTMLElement>('.news-card').forEach(card => {
      const hit = !q || (card.dataset.title ?? '').includes(q);
      card.style.display = hit ? '' : 'none';
      if (hit) visible++;
    });
    if (emptyEl) emptyEl.hidden = visible === 0;
  });
</script>