---
import Admin from '../../layouts/Admin.astro';
import { supabase } from '../../lib/supabase';
const { profile } = Astro.locals;
const isAdmin = (r: string[]) => r.includes(profile?.role ?? '');
const isModerator = isAdmin(['super_admin', 'moderator']);
const unread = isModerator
  ? (await supabase.from('feedback').select('id', { count: 'exact', head: true }).eq('is_read', false)).count ?? 0
  : 0;
const cards = [
  { role: ['super_admin','moderator'], href: '/admin/feedback', title: 'Кабинет доверия', desc: 'Анонимные обращения учеников', icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/>' },
  { role: ['super_admin','moderator','editor'], href: '/admin/news', title: 'Новости', desc: 'Управление публикациями', icon: '<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>' },
  { role: ['super_admin','moderator','editor'], href: '/admin/announcements', title: 'Объявления', desc: 'Для учеников, учителей и родителей', icon: '<path d="M12.988 3.012a1 1 0 0 1 1.024.928l.508 4.069a9 9 0 0 1 6.48 6.48l4.069.508a1 1 0 0 1 0 1.985l-4.069.508a9 9 0 0 1-6.48 6.48l-.508 4.069a1 1 0 0 1-1.985 0l-.508-4.069a9 9 0 0 1-6.48-6.48l-4.069-.508a1 1 0 0 1 0-1.985l4.069-.508a9 9 0 0 1 6.48-6.48l.508-4.069a1 1 0 0 1 1.024-.928ZM14 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"/>' },
  { role: ['super_admin','moderator'], href: '/admin/teachers', title: 'Учителя', desc: 'Кадры и контакты', icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { role: ['super_admin','moderator'], href: '/admin/schedule', title: 'Расписание', desc: 'Редактор + CSV импорт', icon: '<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/>' },
  { role: ['super_admin'], href: '/admin/users', title: 'Пользователи', desc: 'Управление ролями и доступом', icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
];
---
<Admin>
  <header class="mb-8">
    <h1 class="text-3xl font-extrabold mb-1">Панель управления</h1>
    <p class="text-[var(--color-text-secondary)]">Добро пожаловать, {profile?.role}!</p>
  </header>
  <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-6">
    {cards.filter(c => isAdmin(c.role)).map(c => (
      <a href={c.href} class="relative flex items-start gap-4 p-6 bg-white border border-[var(--color-border)] rounded-2xl no-underline text-[var(--color-text-primary)] transition-all hover:border-[var(--color-primary)] hover:shadow-[var(--shadow-md)] hover:-translate-y-0.5">
        {c.href === '/admin/feedback' && unread > 0 && (
          <span class="absolute top-4 right-4 px-2 py-0.5 bg-red-100 text-red-700 border border-red-200 rounded-full text-xs font-bold">{unread}</span>
        )}
        <div class="w-11 h-11 rounded-xl bg-[var(--color-primary-soft)] flex items-center justify-center text-[var(--color-primary)] shrink-0">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
        </div>
        <div><h3 class="m-0 mb-1 font-bold">{c.title}</h3><p class="m-0 text-sm text-[var(--color-text-secondary)]">{c.desc}</p></div>
      </a>
    ))}
  </div>
</Admin>