---
import Admin from '../../layouts/Admin.astro';
import { supabase } from '../../lib/supabase';
import { ADMIN_ROLES } from '../../lib/roles';

const { profile } = Astro.locals;
if (!profile || !ADMIN_ROLES.includes(profile.role)) {
  return Astro.redirect('/admin');
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://placeholder.supabase.co';
const { data: files } = await supabase.storage.from('school-images').list();
const items = (files ?? []).map(f => ({
  name: f.name,
  url: `${supabaseUrl}/storage/v1/object/public/school-images/${f.name}`,
  size: f.metadata?.size ?? 0,
}));
---
<Admin>
  <header class="mb-8">
    <h1 class="text-3xl font-extrabold mb-1">Изображения</h1>
    <p class="text-[var(--color-text-secondary)]">Медиабиблиотека: загрузите фото — и используйте его в новостях, учителях и галерее</p>
  </header>

  <form action="/api/admin/images/upload" method="POST" enctype="multipart/form-data" class="bg-white border border-[var(--color-border)] rounded-2xl p-6 mb-8 shadow-sm">
    <div class="flex gap-4 items-center max-md:flex-col max-md:items-stretch">
      <input class="flex-1 px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="file" name="file" accept="image/*" required />
      <button class="px-5 py-2 bg-[var(--color-primary)] text-white border-none rounded-lg text-sm font-bold cursor-pointer hover:opacity-90 transition-opacity" type="submit">Загрузить</button>
    </div>
    <p class="text-xs text-[var(--color-text-muted)] mt-2 mb-0">JPG, PNG, WebP, GIF, AVIF — до 5 МБ. После загрузки URL появится ниже.</p>
  </form>

  <div class="grid grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-5">
    {items.map(item => (
      <div class="bg-white border border-[var(--color-border)] rounded-2xl overflow-hidden shadow-sm flex flex-col">
        <img src={item.url} alt={item.name} class="w-full h-36 object-cover bg-[var(--color-bg-soft)]" loading="lazy" />
        <div class="p-4 flex flex-col gap-2 flex-1">
          <p class="text-xs text-[var(--color-text-secondary)] break-all m-0">{item.name}</p>
          <p class="text-xs text-[var(--color-text-muted)] m-0">{item.size > 0 ? `${Math.round(item.size / 1024)} КБ` : ''}</p>
          <div class="flex gap-2 mt-auto">
            <button data-copy-url={item.url} class="flex-1 px-3 py-1.5 bg-[var(--color-primary-soft)] text-[var(--color-primary)] rounded-lg text-xs font-bold cursor-pointer border-none hover:opacity-80 transition-opacity" type="button">Скопировать URL</button>
            <form action="/api/admin/images/delete" method="POST" class="inline">
              <input type="hidden" name="name" value={item.name} />
              <button class="px-3 py-1.5 bg-red-50 text-red-600 rounded-lg text-xs font-bold cursor-pointer border border-red-200 hover:bg-red-100 transition-colors" type="submit">Удалить</button>
            </form>
          </div>
        </div>
      </div>
    ))}
    {items.length === 0 && (
      <p class="col-span-full text-center text-[var(--color-text-secondary)] py-12">Пока нет загруженных изображений</p>
    )}
  </div>
</Admin>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-url]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.copyUrl ?? '';
      try {
        await navigator.clipboard.writeText(url);
        const old = btn.textContent;
        btn.textContent = 'Скопировано ✓';
        setTimeout(() => { btn.textContent = old; }, 1500);
      } catch {
        btn.textContent = 'Не удалось скопировать';
      }
    });
  });
</script>