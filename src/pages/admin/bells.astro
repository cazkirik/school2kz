---
import Admin from '../../layouts/Admin.astro';
import { supabase } from '../../lib/supabase';
import { MODERATOR_ROLES } from '../../lib/roles';

const { profile } = Astro.locals;
if (!profile || !MODERATOR_ROLES.includes(profile.role)) {
  return Astro.redirect('/admin');
}

let success = '', error = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action') || 'add';
    if (action === 'add') {
      const shift = (formData.get('shift') as string) || 'first';
      const lessonNumber = parseInt(formData.get('lesson_number') as string, 10);
      const startTime = (formData.get('start_time') as string) || '';
      const endTime = (formData.get('end_time') as string) || '';
      const lang = (formData.get('lang') as string) || 'ru';
      if (!lessonNumber || !startTime || !endTime) throw new Error('Заполните все поля');
      const { error: dbErr } = await supabase.from('bell_schedule').insert({ shift, lesson_number: lessonNumber, start_time: startTime, end_time: endTime, lang });
      if (dbErr) throw dbErr;
      success = 'Звонок добавлен!';
    } else if (action === 'delete') {
      const id = formData.get('id');
      if (!id) throw new Error('Не указан id');
      const { error: dbErr } = await supabase.from('bell_schedule').delete().eq('id', id);
      if (dbErr) throw dbErr;
      success = 'Звонок удалён!';
    }
  } catch (e: any) { error = e.message || 'Ошибка'; }
}

const { data: bells } = await supabase
  .from('bell_schedule')
  .select('*')
  .order('lang')
  .order('shift')
  .order('lesson_number');
const group = (lang: string, shift: string) => (bells ?? []).filter(b => b.lang === lang && b.shift === shift);
---

<Admin>
  <header class="mb-8">
    <h1 class="text-3xl font-extrabold mb-1">Расписание звонков</h1>
    <p class="text-[var(--color-text-secondary)]">Время начала и конца уроков для 1-й и 2-й смены</p>
  </header>

  {success && <div class="bg-green-50 text-green-800 border border-green-200 rounded-lg px-4 py-3 mb-6 text-sm font-medium">{success}</div>}
  {error && <div class="bg-red-50 text-red-800 border border-red-200 rounded-lg px-4 py-3 mb-6 text-sm font-medium">{error}</div>}

  <form method="POST" class="bg-white border border-[var(--color-border)] rounded-2xl p-6 mb-8 shadow-sm">
    <input type="hidden" name="action" value="add" />
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 items-end">
      <div>
        <label class="block text-xs font-bold mb-1">Смена</label>
        <select class="w-full px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm font-[inherit] bg-white" name="shift">
          <option value="first">1-я</option>
          <option value="second">2-я</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-bold mb-1">Урок №</label>
        <input class="w-full px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="number" name="lesson_number" min="1" max="12" required />
      </div>
      <div>
        <label class="block text-xs font-bold mb-1">Начало</label>
        <input class="w-full px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="time" name="start_time" required />
      </div>
      <div>
        <label class="block text-xs font-bold mb-1">Конец</label>
        <input class="w-full px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="time" name="end_time" required />
      </div>
      <div>
        <label class="block text-xs font-bold mb-1">Язык</label>
        <select class="w-full px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm font-[inherit] bg-white" name="lang">
          <option value="ru">RU</option>
          <option value="kk">KK</option>
        </select>
      </div>
    </div>
    <button class="mt-4 px-5 py-2.5 bg-[var(--color-primary)] text-white border-none rounded-lg text-sm font-bold cursor-pointer hover:opacity-90 transition-opacity" type="submit">Добавить звонок</button>
  </form>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {[['ru', 'RU'], ['kk', 'KK']].map(([langKey, langLabel]) => (
      <div class="bg-white border border-[var(--color-border)] rounded-2xl overflow-hidden shadow-sm">
        <h2 class="px-5 py-3 bg-[var(--color-bg-soft)] font-bold border-b border-[var(--color-border)] m-0">{langLabel}</h2>
        {[['first', '1-я смена'], ['second', '2-я смена']].map(([shift, shiftLabel]) => (
          <div class="p-4 border-b border-[var(--color-border)] last:border-b-0">
            <h3 class="text-sm font-bold mb-3 text-[var(--color-text-secondary)]">{shiftLabel}</h3>
            <div class="flex flex-col gap-2">
              {group(langKey, shift).map(b => (
                <div class="flex items-center justify-between gap-3 bg-[var(--color-bg-soft)] rounded-lg px-3 py-2">
                  <span class="text-sm font-bold">{b.lesson_number}</span>
                  <span class="text-sm text-[var(--color-text-secondary)]">{b.start_time} – {b.end_time}</span>
                  <form method="POST" onsubmit="return confirm('Удалить звонок?')">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="id" value={b.id} />
                    <button class="w-7 h-7 rounded-md bg-red-500 text-white border-none text-xs font-bold cursor-pointer hover:opacity-85 transition-opacity" type="submit" title="Удалить">×</button>
                  </form>
                </div>
              ))}
              {group(langKey, shift).length === 0 && <p class="text-xs text-[var(--color-text-muted)] m-0">Пусто</p>}
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>
</Admin>