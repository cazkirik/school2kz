---
import Admin from '../../layouts/Admin.astro';
import { supabase } from '../../lib/supabase';
import { MODERATOR_ROLES } from '../../lib/roles';

const { profile } = Astro.locals;
if (!profile || !MODERATOR_ROLES.includes(profile.role)) {
  return Astro.redirect('/admin');
}

const { data: applications } = await supabase
  .from('applications')
  .select('*')
  .order('created_at', { ascending: false });

const STATUS_META: Record<string, { label: string; cls: string; next: string }> = {
  new: { label: 'Новая', cls: 'bg-amber-100 text-amber-800', next: 'reviewed' },
  reviewed: { label: 'На рассмотрении', cls: 'bg-blue-100 text-blue-800', next: 'accepted' },
  accepted: { label: 'Принята', cls: 'bg-green-100 text-green-800', next: 'rejected' },
  rejected: { label: 'Отклонена', cls: 'bg-red-100 text-red-800', next: 'new' },
};
const countBy = (s: string) => (applications ?? []).filter(a => a.status === s).length;
---

<Admin>
  <header class="mb-8">
    <h1 class="text-3xl font-extrabold mb-1">Заявки (запись в 1 класс)</h1>
    <p class="text-[var(--color-text-secondary)]">Заявления родителей на приём в школу</p>
  </header>

  <div class="flex flex-wrap items-center gap-3 mb-6">
    <span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-sm font-bold">Новых: {countBy('new')}</span>
    <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-bold">На рассмотрении: {countBy('reviewed')}</span>
    <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-bold">Принято: {countBy('accepted')}</span>
    <span class="px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm font-bold">Отклонено: {countBy('rejected')}</span>
    <span class="px-3 py-1 bg-[var(--color-bg-soft)] text-[var(--color-text-secondary)] rounded-full text-sm font-bold">Всего: {applications?.length ?? 0}</span>
  </div>

  <div class="flex flex-col gap-4">
    {(!applications || applications.length === 0) ? (
      <p class="text-center text-[var(--color-text-secondary)] py-12">Заявок пока нет</p>
    ) : applications.map(item => (
      <div class="bg-white border border-[var(--color-border)] rounded-2xl p-6 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex-1 min-w-[260px]">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold {STATUS_META[item.status].cls}">{STATUS_META[item.status].label}</span>
              <span class="text-xs text-[var(--color-text-muted)]">{new Date(item.created_at).toLocaleString('ru-RU')}</span>
            </div>
            <p class="text-base font-bold m-0 mb-1">{item.child_name} <span class="text-sm font-normal text-[var(--color-text-secondary)]">({item.grade} класс)</span></p>
            {item.birth_date && <p class="text-sm text-[var(--color-text-secondary)] m-0 mb-1">Дата рождения: {item.birth_date}</p>}
            <p class="text-sm text-[var(--color-text-secondary)] m-0 mb-1">Родитель: {item.parent_name}</p>
            <p class="text-sm text-[var(--color-text-secondary)] m-0 mb-1">Телефон: <a href={`tel:${item.phone}`} class="text-[var(--color-primary)] font-semibold no-underline">{item.phone}</a></p>
            {item.email && <p class="text-sm text-[var(--color-text-secondary)] m-0">E-mail: {item.email}</p>}
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <form action="/api/admin/applications/status" method="POST">
              <input type="hidden" name="id" value={item.id} />
              <input type="hidden" name="status" value={STATUS_META[item.status].next} />
              <button class="px-4 py-2 bg-[var(--color-primary)] text-white border-none rounded-lg text-xs font-bold cursor-pointer hover:opacity-90 transition-opacity" type="submit">→ {STATUS_META[STATUS_META[item.status].next].label}</button>
            </form>
            <form action="/api/admin/applications/delete" method="POST" onsubmit="return confirm('Удалить заявку?')">
              <input type="hidden" name="id" value={item.id} />
              <button class="px-3 py-2 bg-red-50 text-red-600 border border-red-200 rounded-lg text-xs font-bold cursor-pointer hover:bg-red-100 transition-colors" type="submit">Удалить</button>
            </form>
          </div>
        </div>
      </div>
    ))}
  </div>
</Admin>