---
import Admin from '../../layouts/Admin.astro';
import { supabase } from '../../lib/supabase';
const { profile } = Astro.locals;
if (!profile || !['super_admin','moderator'].includes(profile.role)) return Astro.redirect('/admin');

const { data: teachers } = await supabase
  .from('teachers')
  .select('*')
  .order('last_name', { ascending: true });
---
<Admin>
  <header class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-extrabold mb-1">Учителя</h1>
      <p class="text-[var(--color-text-secondary)]">Управление сотрудниками</p>
    </div>
  </header>

  <form id="add-teacher" class="bg-white border border-[var(--color-border)] rounded-2xl p-6 mb-8 shadow-sm">
    <h2 class="text-lg font-bold mb-4">Добавить учителя</h2>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-3 mb-3">
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="text" name="last_name" placeholder="Фамилия" required />
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="text" name="first_name" placeholder="Имя" required />
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="text" name="subject" placeholder="Предмет" required />
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="text" name="phone" placeholder="Телефон" />
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="email" name="email" placeholder="Email" />
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="text" name="room" placeholder="Кабинет" />
    </div>
    <button class="px-5 py-2 bg-[var(--color-primary)] text-white border-none rounded-lg text-sm font-bold cursor-pointer hover:opacity-90 transition-opacity" type="submit">Добавить</button>
  </form>

  <div class="bg-white border border-[var(--color-border)] rounded-2xl overflow-hidden shadow-sm">
    <table class="w-full border-collapse text-sm">
      <thead class="bg-[var(--color-bg-soft)]">
        <tr>
          <th class="px-4 py-3 text-left font-bold text-[var(--color-text-primary)]">ФИО</th>
          <th class="px-4 py-3 text-left font-bold text-[var(--color-text-primary)]">Предмет</th>
          <th class="px-4 py-3 text-left font-bold text-[var(--color-text-primary)]">Кабинет</th>
          <th class="px-4 py-3 text-left font-bold text-[var(--color-text-primary)]">Телефон</th>
          <th class="px-4 py-3 text-right font-bold text-[var(--color-text-primary)]">Действия</th>
        </tr>
      </thead>
      <tbody>
        {teachers?.map(t => (
          <tr class="border-t border-[var(--color-border)]">
            <td class="px-4 py-3 font-medium">{t.last_name} {t.first_name}</td>
            <td class="px-4 py-3">{t.subject}</td>
            <td class="px-4 py-3">{t.room}</td>
            <td class="px-4 py-3">{t.phone}</td>
            <td class="px-4 py-3 text-right">
              <form action="/api/admin/teachers/delete" method="POST" class="inline">
                <input type="hidden" name="id" value={t.id} />
                <button class="text-xs font-bold text-red-600 bg-transparent border-none cursor-pointer hover:underline" type="submit">Удалить</button>
              </form>
            </td>
          </tr>
        )) || <tr><td class="px-4 py-6 text-center text-[var(--color-text-secondary)]" colspan="5">Учитель пока не добавлен</td></tr>}
      </tbody>
    </table>
  </div>

  <script>
    const form = document.getElementById('add-teacher') as HTMLFormElement;
    if (form) form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      await fetch('/api/admin/teachers/add', { method: 'POST', body: fd });
      window.location.reload();
    });
  </script>
</Admin>