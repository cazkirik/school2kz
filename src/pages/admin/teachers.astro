---
import Admin from '../../layouts/Admin.astro';
import { supabase } from '../../lib/supabase';
import { z } from 'zod';
import { MODERATOR_ROLES } from '../../lib/roles';

const { profile } = Astro.locals;
if (!profile || !MODERATOR_ROLES.includes(profile.role)) {
  return Astro.redirect('/admin');
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://placeholder.supabase.co';
const teacherSchema = z.object({
  last_name: z.string().min(1),
  first_name: z.string().min(1),
  subject: z.string().min(1),
  phone: z.string().optional().default(''),
  email: z.string().optional().default(''),
  room: z.string().optional().default(''),
  experience: z.coerce.number().int().min(0).max(60).optional().default(0),
  photo_url: z.string().optional().default(''),
});
let success = '', error = '';
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action') || 'create';
    const parsed = teacherSchema.parse({
      last_name: formData.get('last_name'),
      first_name: formData.get('first_name'),
      subject: formData.get('subject'),
      phone: formData.get('phone'),
      email: formData.get('email'),
      room: formData.get('room'),
      experience: formData.get('experience') || 0,
      photo_url: formData.get('photo_url'),
    });
    const full_name = `${parsed.last_name} ${parsed.first_name}`.trim();
    const payload = {
      last_name: parsed.last_name,
      first_name: parsed.first_name,
      full_name,
      subject: parsed.subject,
      phone: parsed.phone || null,
      email: parsed.email || null,
      room: parsed.room || null,
      experience: parsed.experience || null,
      photo_url: parsed.photo_url || null,
    };
    if (action === 'update') {
      const id = formData.get('id');
      if (!id) throw new Error('Не указан id');
      const { error: dbErr } = await supabase.from('teachers').update(payload).eq('id', id);
      if (dbErr) throw dbErr;
      success = 'Учитель обновлён!';
    } else {
      const { error: dbErr } = await supabase.from('teachers').insert(payload);
      if (dbErr) throw dbErr;
      success = 'Учитель добавлен!';
    }
  } catch (e: any) { error = e.message || 'Ошибка сохранения'; }
}

const editId = Astro.url.searchParams.get('edit');
let editing = null;
if (editId) {
  const { data: item } = await supabase.from('teachers').select('*').eq('id', editId).single();
  editing = item;
}

const { data: storageFiles } = await supabase.storage.from('school-images').list();
const imageOptions = (storageFiles ?? []).map(f => `${supabaseUrl}/storage/v1/object/public/school-images/${f.name}`);

const { data: teachers } = await supabase
  .from('teachers')
  .select('*')
  .order('last_name', { ascending: true });
---
<Admin>
  <header class="mb-8">
    <div>
      <h1 class="text-3xl font-extrabold mb-1">Учителя</h1>
      <p class="text-[var(--color-text-secondary)]">{editing ? `Редактирование: ${editing.full_name}` : 'Управление сотрудниками'}</p>
    </div>
  </header>

  {success && <div class="bg-green-50 text-green-800 border border-green-200 rounded-lg px-4 py-3 mb-6 text-sm font-medium">{success}</div>}
  {error && <div class="bg-red-50 text-red-800 border border-red-200 rounded-lg px-4 py-3 mb-6 text-sm font-medium">{error}</div>}

  {editing && <div class="mb-4"><a href="/admin/teachers" class="text-sm font-bold text-[var(--color-primary)] no-underline">&larr; К списку учителей</a></div>}

  <form method="POST" class="bg-white border border-[var(--color-border)] rounded-2xl p-6 mb-8 shadow-sm">
    <h2 class="text-lg font-bold mb-4">{editing ? 'Редактировать учителя' : 'Добавить учителя'}</h2>
    {editing && <input type="hidden" name="id" value={editing.id} />}
    <input type="hidden" name="action" value={editing ? 'update' : 'create'} />
    <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-3 mb-3">
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="text" name="last_name" placeholder="Фамилия" required value={editing?.last_name ?? ''} />
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="text" name="first_name" placeholder="Имя" required value={editing?.first_name ?? ''} />
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="text" name="subject" placeholder="Предмет" required value={editing?.subject ?? ''} />
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="text" name="experience" placeholder="Стаж (лет)" value={editing?.experience ?? ''} />
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="text" name="phone" placeholder="Телефон" value={editing?.phone ?? ''} />
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="email" name="email" placeholder="Email" value={editing?.email ?? ''} />
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="text" name="room" placeholder="Кабинет" value={editing?.room ?? ''} />
    </div>
    <div class="mb-3 max-w-xl">
      <label class="block text-xs font-bold text-[var(--color-text-secondary)] mb-1.5">Фото (портрет)</label>
      <input id="photo-url-input" class="w-full px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm mb-2" type="url" name="photo_url" placeholder="https://… или выберите из библиотеки" value={editing?.photo_url ?? ''} />
      <select id="photo-picker" class="w-full px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm font-[inherit]">
        <option value="">— Выбрать из загруженных —</option>
        {imageOptions.map(u => (
          <option value={u} selected={editing?.photo_url === u}>{u.split('/').pop()}</option>
        ))}
      </select>
      {editing?.photo_url && (
        <div class="mt-2">
          <img src={editing.photo_url} alt="" class="w-16 h-16 object-cover rounded-full border border-[var(--color-border)]" />
        </div>
      )}
    </div>
    <button class="px-5 py-2 bg-[var(--color-primary)] text-white border-none rounded-lg text-sm font-bold cursor-pointer hover:opacity-90 transition-opacity" type="submit">{editing ? 'Сохранить' : 'Добавить'}</button>
  </form>

  <div class="bg-white border border-[var(--color-border)] rounded-2xl overflow-hidden shadow-sm">
    <table class="w-full border-collapse text-sm">
      <thead class="bg-[var(--color-bg-soft)]">
        <tr>
          <th class="px-4 py-3 text-left font-bold text-[var(--color-text-primary)]">Фото</th>
          <th class="px-4 py-3 text-left font-bold text-[var(--color-text-primary)]">ФИО</th>
          <th class="px-4 py-3 text-left font-bold text-[var(--color-text-primary)]">Предмет</th>
          <th class="px-4 py-3 text-left font-bold text-[var(--color-text-primary)]">Кабинет</th>
          <th class="px-4 py-3 text-left font-bold text-[var(--color-text-primary)]">Телефон</th>
          <th class="px-4 py-3 text-right font-bold text-[var(--color-text-primary)]">Действия</th>
        </tr>
      </thead>
      <tbody>
        {teachers?.map(t => (
          <tr class="border-t border-[var(--color-border)]">
            <td class="px-4 py-3">
              {t.photo_url
                ? <img src={t.photo_url} alt="" class="w-10 h-10 object-cover rounded-full border border-[var(--color-border)]" loading="lazy" />
                : <span class="text-xs text-[var(--color-text-muted)]">нет</span>}
            </td>
            <td class="px-4 py-3 font-medium">{t.last_name} {t.first_name}</td>
            <td class="px-4 py-3">{t.subject}</td>
            <td class="px-4 py-3">{t.room}</td>
            <td class="px-4 py-3">{t.phone}</td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <a href={`/admin/teachers?edit=${t.id}`} class="text-xs font-bold text-[var(--color-primary)] no-underline mr-3 hover:underline">Редактировать</a>
              <form action="/api/admin/teachers/delete" method="POST" class="inline">
                <input type="hidden" name="id" value={t.id} />
                <button class="text-xs font-bold text-red-600 bg-transparent border-none cursor-pointer hover:underline" type="submit">Удалить</button>
              </form>
            </td>
          </tr>
        )) || <tr><td class="px-4 py-6 text-center text-[var(--color-text-secondary)]" colspan="6">Учитель пока не добавлен</td></tr>}
      </tbody>
    </table>
  </div>
</Admin>

<script>
  const picker = document.getElementById('photo-picker') as HTMLSelectElement | null;
  const input = document.getElementById('photo-url-input') as HTMLInputElement | null;
  picker?.addEventListener('change', () => {
    if (picker.value && input) input.value = picker.value;
  });
</script>