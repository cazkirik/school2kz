---
import Admin from '../../layouts/Admin.astro';
import { supabase } from '../../lib/supabase';
import { z } from 'zod';

const newsSchema = z.object({ title: z.string().min(1), description: z.string().min(1), content: z.string().min(1), date: z.string(), lang: z.enum(['ru', 'kk']).default('ru') });
let success = '', error = '';
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const parsed = newsSchema.parse({
      title: formData.get('title'), description: formData.get('description'),
      content: formData.get('content'), date: formData.get('date') || new Date().toISOString(),
      lang: formData.get('lang') || 'ru',
    });
    const slug = parsed.title.toLowerCase().replace(/[^a-zа-яё0-9]+/g, '-').replace(/-+$/, '');
    const { error: dbErr } = await supabase.from('news').insert({ slug, title: parsed.title, description: parsed.description, content: parsed.content, date: parsed.date, lang: parsed.lang });
    if (dbErr) throw dbErr;
    success = 'Новость опубликована!';
  } catch (e: any) { error = e.message || 'Ошибка публикации'; }
}
const { data: newsList } = await supabase.from('news').select('*').order('date', { ascending: false });
---
<Admin>
  <header class="mb-8">
    <h1 class="text-3xl font-extrabold mb-1">Новости</h1>
    <p class="text-[var(--color-text-secondary)]">Публикация новостей школы</p>
  </header>

  {success && <div class="bg-green-50 text-green-800 border border-green-200 rounded-lg px-4 py-3 mb-6 text-sm font-medium">{success}</div>}
  {error && <div class="bg-red-50 text-red-800 border border-red-200 rounded-lg px-4 py-3 mb-6 text-sm font-medium">{error}</div>}

  <form method="POST" class="bg-white border border-[var(--color-border)] rounded-2xl p-6 mb-8 shadow-sm">
    <div class="grid grid-cols-2 gap-4 mb-4">
      <input class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="text" name="title" placeholder="Заголовок" required />
      <div class="flex gap-4">
        <input class="flex-1 px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm" type="date" name="date" />
        <select class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm font-[inherit]" name="lang">
          <option value="ru">Русский</option>
          <option value="kk">Қазақша</option>
        </select>
      </div>
      <textarea class="col-span-2 px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm min-h-[60px]" name="description" placeholder="Краткое описание" required />
      <textarea class="col-span-2 px-3 py-2 border border-[var(--color-border)] rounded-lg text-sm min-h-[150px]" name="content" placeholder="Полный текст (Markdown)" required />
    </div>
    <button class="px-5 py-2 bg-[var(--color-primary)] text-white border-none rounded-lg text-sm font-bold cursor-pointer hover:opacity-90 transition-opacity" type="submit">Опубликовать</button>
  </form>

  <div class="bg-white border border-[var(--color-border)] rounded-2xl overflow-hidden shadow-sm">
    <table class="w-full border-collapse text-sm">
      <thead class="bg-[var(--color-bg-soft)]">
        <tr>
          <th class="px-4 py-3 text-left font-bold text-[var(--color-text-primary)]">Заголовок</th>
          <th class="px-4 py-3 text-left font-bold text-[var(--color-text-primary)]">Язык</th>
          <th class="px-4 py-3 text-left font-bold text-[var(--color-text-primary)]">Дата</th>
          <th class="px-4 py-3 text-right font-bold text-[var(--color-text-primary)]">Действия</th>
        </tr>
      </thead>
      <tbody>
        {newsList?.map(item => (
          <tr class="border-t border-[var(--color-border)]">
            <td class="px-4 py-3 font-medium">{item.title}</td>
            <td class="px-4 py-3 text-[var(--color-text-secondary)]">{item.lang === 'ru' ? 'Рус' : 'Қаз'}</td>
            <td class="px-4 py-3 text-[var(--color-text-muted)]">{new Date(item.date).toLocaleDateString('ru-RU')}</td>
            <td class="px-4 py-3 text-right">
              <form action="/api/admin/news/delete" method="POST" class="inline">
                <input type="hidden" name="id" value={item.id} />
                <button class="text-xs font-bold text-red-600 bg-transparent border-none cursor-pointer hover:underline" type="submit">Удалить</button>
              </form>
            </td>
          </tr>
        )) || <tr><td class="px-4 py-6 text-center text-[var(--color-text-secondary)]" colspan="4">Новостей пока нет</td></tr>}
      </tbody>
    </table>
  </div>
</Admin>