---
import Base from '../layouts/Base.astro';
import { siteConfig } from '../siteConfig';
import { ui } from '../i18n/ui';
import ContactsView from '../components/ContactsView.astro';

const lang = 'ru';
const t = ui[lang];
---

<Base lang={lang} title={`${t.contacts.title} — ${siteConfig.name[lang]}`}>
  <ContactsView lang={lang} />
</Base>
