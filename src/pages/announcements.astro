---
import Base from '../layouts/Base.astro';
import { siteConfig } from '../siteConfig';
import { ui } from '../i18n/ui';
import AnnouncementsView from '../components/AnnouncementsView.astro';

const lang = 'ru';
const t = ui[lang];
---
<Base lang={lang} title={`${t.announcements.title} — ${siteConfig.name[lang]}`}>
  <AnnouncementsView lang={lang} />
</Base>