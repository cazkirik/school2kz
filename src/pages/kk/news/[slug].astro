---
import Base from '../../../layouts/Base.astro';
import { siteConfig } from '../../../siteConfig';
import NewsPostView from '../../../components/NewsPostView.astro';
import { supabase } from '../../../lib/supabase';

export const prerender = false;

const { slug } = Astro.params;
const lang = 'kk';

const { data: news } = await supabase
  .from('news')
  .select('*')
  .eq('slug', slug)
  .eq('lang', lang)
  .maybeSingle();

if (!news) {
  return Astro.redirect('/kk/news/');
}

const { data: similar } = await supabase
  .from('news')
  .select('id, slug, title, description, date, image_url')
  .eq('lang', lang)
  .neq('slug', slug)
  .order('date', { ascending: false })
  .limit(2);
---

<Base lang={lang} title={`${news.title} — ${siteConfig.name[lang]}`} description={news.description}>
  <NewsPostView lang={lang} news={news} similar={similar ?? []} />
</Base>