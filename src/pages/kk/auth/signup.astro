---
import Base from '../../../layouts/Base.astro';
import { siteConfig } from '../../../siteConfig';
import { ui } from '../../../i18n/ui';

const lang = 'kk';
const t = ui[lang];
---
<Base lang={lang} title={`${t.register} — ${siteConfig.name[lang]}`}>
  <section class="py-24 min-h-[60vh] flex items-center">
    <div class="max-w-[400px] mx-auto text-center w-full px-4">
      <h1 class="text-3xl font-extrabold mb-2">{t.register}</h1>
      <form id="signup-form" class="flex flex-col gap-3 mb-4">
        <input class="px-4 py-3 border border-[var(--color-border)] rounded-lg text-base font-[inherit]" type="text" name="full_name" placeholder="Аты-жөні" required />
        <input class="px-4 py-3 border border-[var(--color-border)] rounded-lg text-base font-[inherit]" type="email" name="email" placeholder="Email" required />
        <input class="px-4 py-3 border border-[var(--color-border)] rounded-lg text-base font-[inherit]" type="password" name="password" placeholder="Құпиясөз (кемінде 6)" required minlength="6" />
        <button class="px-4 py-3 bg-[var(--color-primary)] text-white border-none rounded-lg font-bold text-base cursor-pointer hover:opacity-90" type="submit">{t.register}</button>
      </form>
      <p class="text-sm text-[var(--color-text-secondary)]"><a class="text-[var(--color-primary)] font-semibold" href="/kk/login">Кіру</a> · <a class="text-[var(--color-primary)] font-semibold" href="/auth/signup">Рус</a></p>
      <p id="auth-message" class="mt-4 px-4 py-3 rounded-lg font-medium hidden"></p>
    </div>
  </section>
</Base>
<script>
  import { supabase } from '../../../lib/supabase';
  const form = document.getElementById('signup-form') as HTMLFormElement | null;
  const msg = document.getElementById('auth-message') as HTMLElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const full_name = fd.get('full_name') as string;
      const email = fd.get('email') as string;
      const password = fd.get('password') as string;
      const btn = form.querySelector('button') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Тіркелу...';
      const { data, error } = await supabase.auth.signUp({
        email,
        password,
        options: { data: { full_name } }
      });
      if (error) { if (msg) { msg.textContent = 'Қате: ' + error.message; msg.className = 'mt-4 px-4 py-3 rounded-lg font-medium bg-red-50 text-red-800 border border-red-200'; msg.hidden = false; } btn.disabled = false; btn.textContent = 'Тіркелу'; return; }
      if (data.session) { await supabase.from('profiles').upsert({ id: data.user!.id, full_name, role: 'student' }); }
      if (msg) { msg.textContent = 'Аккаунт жасалды! Растау үшін поштаңызды тексеріңіз.'; msg.className = 'mt-4 px-4 py-3 rounded-lg font-medium bg-green-50 text-green-800 border border-green-200'; msg.hidden = false; }
      btn.disabled = false; btn.textContent = 'Тіркелу';
    });
  }
</script>