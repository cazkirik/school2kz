---
import Base from '../../../layouts/Base.astro';
import { siteConfig } from '../../../siteConfig';
import PublicationsPostView from '../../../components/PublicationsPostView.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('publications');
  return entries
    .filter((e) => e.data.lang === 'kk')
    .map((entry) => ({
      params: { slug: entry.id.split('/')[0] },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const lang = 'kk';
const similar = (await getCollection('publications'))
  .filter((e) => e.data.lang === 'kk' && e.id.split('/')[0] !== entry.id.split('/')[0])
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Base lang={lang} title={`${entry.data.title} — ${siteConfig.name[lang]}`} description={entry.data.description}>
  <PublicationsPostView lang={lang} entry={entry} similar={similar} />
</Base>
