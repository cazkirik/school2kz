import { ui } from '../i18n/ui';
import { siteConfig } from '../siteConfig';
import ScheduleView from '../components/ScheduleView.astro';

const lang = 'ru';
const t = ui[lang].schedule;
---
<Base lang={lang} title={`${t.title} — ${siteConfig.name[lang]}`}>
  <ScheduleView lang={lang} />
</Base>