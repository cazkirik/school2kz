---
import Base from '../../layouts/Base.astro';
import { siteConfig } from '../../siteConfig';
---
<Base lang="ru" title={`Новый пароль — ${siteConfig.name['ru']}`}>
  <section class="py-24 min-h-[60vh] flex items-center">
    <div class="max-w-[400px] mx-auto text-center w-full px-4">
      <h1 class="text-3xl font-extrabold mb-2">Новый пароль</h1>
      <p class="text-[var(--color-text-secondary)] mb-8">Придумайте новый пароль для входа</p>

      <form id="update-form" class="flex flex-col gap-3 mb-4 hidden">
        <input class="px-4 py-3 border border-[var(--color-border)] rounded-lg text-base font-[inherit]" type="password" name="password" placeholder="Новый пароль (мин. 6 символов)" required minlength="6" />
        <input class="px-4 py-3 border border-[var(--color-border)] rounded-lg text-base font-[inherit]" type="password" name="password2" placeholder="Повторите пароль" required minlength="6" />
        <button class="px-4 py-3 bg-[var(--color-primary)] text-white border-none rounded-lg font-bold text-base cursor-pointer hover:opacity-90" type="submit">Сохранить пароль</button>
      </form>

      <p class="mt-6 text-sm text-[var(--color-text-secondary)]"><a href="/login" class="text-[var(--color-primary)] font-semibold">Войти</a></p>
      <p id="auth-message" class="mt-4 px-4 py-3 rounded-lg font-medium hidden"></p>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../../lib/supabase';
  const form = document.getElementById('update-form') as HTMLFormElement | null;
  const msg = document.getElementById('auth-message') as HTMLElement | null;
  function showMsg(text: string, type: string) {
    if (!msg) return;
    msg.textContent = text;
    msg.className = `mt-4 px-4 py-3 rounded-lg font-medium ${type === 'error' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'}`;
    msg.hidden = false;
  }
  (async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      form?.classList.remove('hidden');
    } else {
      showMsg('Ссылка устарела или недействительна. Запросите восстановление пароля заново.', 'error');
    }
  })();
  if (form) form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const password = fd.get('password') as string;
    const password2 = fd.get('password2') as string;
    if (password !== password2) { showMsg('Пароли не совпадают.', 'error'); return; }
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Сохранение...';
    const { error } = await supabase.auth.updateUser({ password });
    if (error) {
      if (error.status === 429) { showMsg('Слишком много запросов. Подождите несколько минут.', 'error'); }
      else { showMsg('Ошибка: ' + error.message, 'error'); }
      btn.disabled = false; btn.textContent = 'Сохранить пароль';
    } else {
      showMsg('Пароль обновлён. Теперь войдите с новым паролем.', 'ok');
      form.classList.add('hidden');
      setTimeout(() => { window.location.href = '/login'; }, 2000);
    }
  });
</script>