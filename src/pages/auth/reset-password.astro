---
import Base from '../../layouts/Base.astro';
import { siteConfig } from '../../siteConfig';
---
<Base lang="ru" title={`Восстановление пароля — ${siteConfig.name['ru']}`}>
  <section class="py-24 min-h-[60vh] flex items-center">
    <div class="max-w-[400px] mx-auto text-center w-full px-4">
      <h1 class="text-3xl font-extrabold mb-2">Восстановление пароля</h1>
      <p class="text-[var(--color-text-secondary)] mb-8">Введите email — мы отправим письмо со ссылкой для смены пароля</p>

      <form id="reset-form" class="flex flex-col gap-3 mb-4">
        <input class="px-4 py-3 border border-[var(--color-border)] rounded-lg text-base font-[inherit]" type="email" name="email" placeholder="Email" required />
        <button class="px-4 py-3 bg-[var(--color-primary)] text-white border-none rounded-lg font-bold text-base cursor-pointer hover:opacity-90" type="submit">Отправить ссылку</button>
      </form>

      <p class="mt-6 text-sm text-[var(--color-text-secondary)]">Вспомнили пароль? <a href="/login" class="text-[var(--color-primary)] font-semibold">Войти</a></p>
      <p id="auth-message" class="mt-4 px-4 py-3 rounded-lg font-medium hidden"></p>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../../lib/supabase';
  const form = document.getElementById('reset-form') as HTMLFormElement | null;
  const msg = document.getElementById('auth-message') as HTMLElement | null;
  function showMsg(text: string, type: string) {
    if (!msg) return;
    msg.textContent = text;
    msg.className = `mt-4 px-4 py-3 rounded-lg font-medium ${type === 'error' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'}`;
    msg.hidden = false;
  }
  if (form) form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const email = (fd.get('email') as string).trim();
    if (!email) return;
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Отправка...';
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/auth/update-password`
    });
    if (error) {
      if (error.status === 429) { showMsg('Слишком много запросов. Подождите несколько минут и попробуйте снова.', 'error'); }
      else { showMsg('Ошибка: ' + error.message, 'error'); }
      btn.disabled = false; btn.textContent = 'Отправить ссылку';
    } else {
      showMsg('Если такой email зарегистрирован, письмо отправлено. Проверьте почту (и спам).', 'ok');
      form.classList.add('hidden');
    }
  });
</script>