---
import Base from '../../layouts/Base.astro';
import { siteConfig } from '../../siteConfig';
---
<Base lang="ru" title={`Авторизация — ${siteConfig.name['ru']}`}>
  <section class="py-24 min-h-[60vh] flex items-center">
    <div class="max-w-[400px] mx-auto text-center w-full px-4">
      <div class="flex flex-col items-center gap-4">
        <div class="w-10 h-10 border-3 border-[var(--color-border)] border-t-[var(--color-primary)] rounded-full animate-spin"></div>
        <p>Завершение входа...</p>
      </div>
      <p id="auth-message" class="mt-4 px-4 py-3 rounded-lg font-medium hidden"></p>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../../lib/supabase';

  const msg = document.getElementById('auth-message') as HTMLElement | null;
  const urlParams = new URLSearchParams(window.location.search);
  const redirect = urlParams.get('redirect') || '/admin';

  function showError(message: string) {
    if (!msg) return;
    msg.textContent = message;
    msg.className = 'mt-4 px-4 py-3 rounded-lg font-medium bg-red-50 text-red-800 border border-red-200';
    msg.hidden = false;
  }

  async function finishLogin() {
    const { data: { session }, error } = await supabase.auth.getSession();

    if (error) {
      showError('Ошибка авторизации: ' + error.message);
      return;
    }

    if (session) {
      document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=3600; samesite=lax`;
      document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=86400; samesite=lax`;
      const { data: profile } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', session.user.id)
        .single();

      if (profile && ['super_admin', 'moderator', 'editor'].includes(profile.role)) {
        window.location.href = redirect && redirect !== '/admin' ? redirect : '/admin';
        return;
      } else {
        window.location.href = '/cabinet';
        return;
      }
    }

    window.location.href = '/login?redirect=' + encodeURIComponent(redirect);
  }

  finishLogin();
</script>