---
import Base from '../layouts/Base.astro';
import { siteConfig } from '../siteConfig';

const lang = 'ru';
const rawRedirect = Astro.url.searchParams.get('redirect') || '/admin';
const redirect = rawRedirect.startsWith('/') && !rawRedirect.startsWith('//') && !rawRedirect.includes('://') ? rawRedirect : '/admin';
---
<Base lang={lang} title={`Вход — ${siteConfig.name[lang]}`}>
  <section class="py-24 min-h-[60vh] flex items-center">
    <div class="max-w-[400px] mx-auto text-center w-full px-4">
      <h1 class="text-3xl font-extrabold mb-2">Вход</h1>
      <p class="text-[var(--color-text-secondary)] mb-8">Введите ваш email и пароль</p>

      <form id="login-form" class="flex flex-col gap-3 mb-4">
        <input type="hidden" name="redirect" value={redirect} />
        <input class="px-4 py-3 border border-[var(--color-border)] rounded-lg text-base font-[inherit]" type="email" name="email" placeholder="Email" required />
        <input class="px-4 py-3 border border-[var(--color-border)] rounded-lg text-base font-[inherit]" type="password" name="password" placeholder="Пароль" required />
        <button id="login-btn" class="px-4 py-3 bg-[var(--color-primary)] text-white border-none rounded-lg font-bold text-base cursor-pointer hover:opacity-90" type="submit">Войти</button>
      </form>
      <p class="text-sm text-left -mt-2"><a href="/auth/reset-password" class="text-[var(--color-text-secondary)] hover:text-[var(--color-primary)]">Забыли пароль?</a></p>

      <p class="mt-6 text-sm text-[var(--color-text-secondary)]">Нет аккаунта? <a href="/auth/signup" class="text-[var(--color-primary)] font-semibold">Зарегистрироваться</a></p>
      <p id="auth-message" class="mt-4 px-4 py-3 rounded-lg font-medium hidden"></p>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  const loginForm = document.getElementById('login-form') as HTMLFormElement | null;
  const msg = document.getElementById('auth-message') as HTMLElement | null;
  const rawRedirect = new URLSearchParams(window.location.search).get('redirect') || '/admin';
  const redirect = rawRedirect.startsWith('/') && !rawRedirect.startsWith('//') && !rawRedirect.includes('://') ? rawRedirect : '/admin';

  function showMsg(text: string, type: string) {
    if (!msg) return;
    msg.textContent = text;
    msg.className = `mt-4 px-4 py-3 rounded-lg font-medium ${type === 'error' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'}`;
    msg.hidden = false;
  }

  function setLoggedIn(session: any) {
    document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=3600; samesite=lax`;
    document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=86400; samesite=lax`;
  }

  async function routeByRole(userId: string) {
    const { data: profile } = await supabase.from('profiles').select('role').eq('id', userId).single();
    const isAdmin = profile && ['super_admin', 'moderator', 'editor'].includes(profile.role);
    const target = isAdmin ? (redirect && redirect !== '/admin' ? redirect : '/admin') : '/cabinet';
    window.location.href = target;
  }

  if (loginForm) loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(loginForm);
    const email = (fd.get('email') as string).trim();
    const password = fd.get('password') as string;
    if (!email || !password) return;
    const btn = loginForm.querySelector('button') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Вход...';
    const { data, error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) {
        showMsg('Ошибка входа: ' + error.message, 'error');
        btn.disabled = false; btn.textContent = 'Войти';
    } else if (data.session) {
      setLoggedIn(data.session);
      await routeByRole(data.session.user.id);
    }
  });
</script>